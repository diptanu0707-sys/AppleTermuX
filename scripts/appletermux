#!/data/data/com.termux/files/usr/bin/bash

VERSION="1.0.0"

case "$1" in
  help|"")
    echo "🍎 AppleTermuX v$VERSION"
    echo ""
    echo "Usage:"
    echo "  appletermux help"
    echo "  appletermux info"
    echo "  appletermux doctor"
    echo "  appletermux update"
    echo "  appletermux clean"
    echo "  appletermux self-update"
    echo "  appletermux version"
    ;;

  version)
    echo "AppleTermuX v$VERSION"
    ;;

  info)
    fastfetch
    ;;

  doctor)
    echo "Running diagnostics..."
    command -v git >/dev/null && echo "✅ Git installed" || echo "❌ Git missing"
    command -v zsh >/dev/null && echo "✅ Zsh installed" || echo "❌ Zsh missing"
    command -v fastfetch >/dev/null && echo "✅ Fastfetch installed" || echo "❌ Fastfetch missing"
    ;;

  update)
    pkg update -y && pkg upgrade -y
    ;;

  clean)
    echo "🧹 Cleaning Termux..."

    pkg autoclean -y
    pkg clean -y

    rm -rf "$HOME/.cache"/* 2>/dev/null

    echo ""
    echo "✅ Cleanup completed!"
    ;;

  self-update)
    echo "🔄 Checking for updates..."

    if [ ! -d ".git" ]; then
      echo "❌ This directory is not a Git repository."
      exit 1
    fi

    git pull origin main

    echo ""
    echo "✅ AppleTermuX has been updated."
    echo "If install.sh changed, run:"
    echo "  bash install.sh"
    ;;

  *)
    echo "Unknown command: $1"
    echo "Run: appletermux help"
    ;;
esac
